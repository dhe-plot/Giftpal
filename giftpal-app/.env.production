# GIFTPAL Frontend Production Environment Configuration

# API Configuration - Update with your production backend URL
VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME=GIFTPAL
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=The Ultimate Gift Marketplace

# Authentication
VITE_AUTH_TOKEN_KEY=giftpal_token
VITE_AUTH_USER_KEY=giftpal_user
VITE_AUTH_REFRESH_KEY=giftpal_refresh_token

# Clerk Configuration (if using Clerk for auth)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_live_publishable_key

# Stripe Configuration (Public Keys Only) - Use live keys for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-live-publishable-key

# Cloudinary Configuration (for image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-production-upload-preset

# Feature Flags
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SELLER_REGISTRATION=true
VITE_ENABLE_PLACEHOLDER_SYSTEM=true

# Development Settings - Disable for production
VITE_DEBUG_MODE=false
VITE_SHOW_API_LOGS=false

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-production-google-maps-api-key
VITE_ANALYTICS_ID=your-production-analytics-id

# Social Media Links
VITE_SOCIAL_FACEBOOK=https://facebook.com/giftpal
VITE_SOCIAL_TWITTER=https://twitter.com/giftpal
VITE_SOCIAL_INSTAGRAM=https://instagram.com/giftpal
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/giftpal

# Contact Information
VITE_CONTACT_EMAIL=support@giftpal.com
VITE_CONTACT_PHONE=+1-555-GIFTPAL
VITE_CONTACT_ADDRESS=123 Gift Street, Present City, PC 12345

# SEO Configuration
VITE_SEO_TITLE=GIFTPAL - The Ultimate Gift Marketplace
VITE_SEO_DESCRIPTION=Discover perfect gifts for every occasion. Connect with local artisans and find unique, personalized gifts that create lasting memories.
VITE_SEO_KEYWORDS=gifts,marketplace,artisans,personalized,unique,occasions,shopping

# Performance Settings
VITE_IMAGE_OPTIMIZATION=true
VITE_LAZY_LOADING=true
VITE_CACHE_DURATION=3600000

# CDN Configuration (if using a CDN)
VITE_CDN_URL=https://your-cdn-domain.com
VITE_ASSETS_URL=https://your-assets-domain.com
