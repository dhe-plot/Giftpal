# Clerk Configuration
# Get these from your Clerk Dashboard (https://dashboard.clerk.com)
# Sign up for a free account and create a new application
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Stripe Configuration  
# Get these from your Stripe Dashboard (https://dashboard.stripe.com)
# Use test keys for development (pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# API Configuration
VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_TIMEOUT=10000
VITE_APP_NAME=GIFTPAL
VITE_APP_VERSION=1.0.0

# Authentication
VITE_AUTH_TOKEN_KEY=giftpal_token
VITE_AUTH_USER_KEY=giftpal_user
VITE_AUTH_REFRESH_KEY=giftpal_refresh_token

# Feature Flags
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SELLER_REGISTRATION=true
VITE_ENABLE_PLACEHOLDER_SYSTEM=true

# Development Settings
VITE_DEBUG_MODE=true
VITE_SHOW_API_LOGS=true
