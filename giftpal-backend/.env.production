# GIFTPAL Backend Production Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=4000

# Frontend URLs (for CORS) - Update with your production domains
FRONTEND_URL=https://your-frontend-domain.com
ADMIN_URL=https://your-admin-domain.com

# Database Configuration - Update with your production database
DB_ENABLED=true
DB_TYPE=postgresql
DB_HOST=your-production-db-host
DB_PORT=5432
DB_NAME=giftpal_production
DB_USER=giftpal_prod_user
DB_PASSWORD=your-secure-production-password
DB_SSL=true

# JWT Configuration - CHANGE THESE IN PRODUCTION
JWT_SECRET=your-super-secure-jwt-secret-key-for-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-for-production
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-production-cloudinary-api-key
CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# Stripe Configuration - Use live keys for production
STRIPE_SECRET_KEY=sk_live_your-stripe-live-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-live-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-live-webhook-secret

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASS=your-production-app-password
EMAIL_FROM=GIFTPAL <noreply@giftpal.com>

# Placeholder System Configuration
PLACEHOLDER_REPLACEMENT_ENABLED=true
DEFAULT_BUSINESS_NAME=Your Business Name
DEFAULT_BUSINESS_DESCRIPTION=Your business description will appear here
DEFAULT_CONTACT_EMAIL=contact@yourbusiness.com
DEFAULT_CONTACT_PHONE=+1-555-0123
DEFAULT_BUSINESS_ADDRESS=123 Business St, City, State 12345

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-production-session-secret

# Logging
LOG_LEVEL=info
LOG_FILE=logs/giftpal-production.log

# Cache Configuration
REDIS_URL=redis://your-production-redis-host:6379
CACHE_TTL=3600

# External APIs
GOOGLE_MAPS_API_KEY=your-production-google-maps-api-key
ANALYTICS_API_KEY=your-production-analytics-api-key

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Monitoring
SENTRY_DSN=your-sentry-dsn-for-error-tracking
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
